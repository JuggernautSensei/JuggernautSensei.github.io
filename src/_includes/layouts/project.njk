---
layout: layouts/prototype.njk
article: true
---
<article class="post">
  {% if cover %}
    <figure class="post-hero"><img src="{{ cover }}" alt="{{ coverAlt }}"></figure>
  {% else %}
    <div class="post-hero diagram-cover" aria-hidden="true"><div class="cover-nodes"><span>CODE</span><span>→</span><b>{{ title }}</b><span>→</span><span>BUILD</span></div></div>
  {% endif %}
  <div class="wrap">
    <header class="post-head">
      <p class="eyebrow">프로젝트 / {{ category }}</p>
      <h1>{{ displayTitle or title }}</h1>
      <p class="standfirst">{{ description }}</p>
      <div class="byline"><b>안지우</b></div>
      {% if technologies %}<div class="project-facts">{% for tech in technologies %}<span>{{ tech }}</span>{% endfor %}</div>{% endif %}
    </header>
    <div class="post-body">
      {% if page.fileSlug == 'juggfx' %}
        {% include 'prototype/juggfx-body.njk' %}
      {% elif page.fileSlug == 'metalslug2-clone' %}
        {% include 'prototype/metalslug-body.njk' %}
      {% else %}
        <section id="overview" class="reveal"><h2>개요</h2>{{ content | safe }}</section>
      {% endif %}
      <section id="links" class="reveal"><h2>관련 자료</h2>{% if repository %}<p>전체 코드와 공개 개발 문서는 저장소에서 확인할 수 있습니다.</p><p><a class="inline" href="{{ repository }}">{{ title }} 저장소 ↗</a></p>{% endif %}{% if notionUrl %}<p><a class="inline" href="{{ notionUrl }}">Notion 원문 보기 ↗</a></p>{% endif %}</section>
    </div>
    <div class="post-foot"><a class="backall" href="/projects/">← 전체 프로젝트</a><a class="backall" href="/#work">메인으로 ↗</a></div>
  </div>
</article>
