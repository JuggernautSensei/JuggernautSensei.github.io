<section class="hero" id="home">
  <div class="hero-backgrounds" data-interval="{{ hero.intervalMs }}" aria-hidden="true">
    {% for slide in hero.slides %}<img class="hero__img{% if loop.first %} is-active{% endif %}" src="{{ slide.src }}" alt="" style="object-position:{{ slide.position }}"{% if loop.first %} fetchpriority="high"{% else %} loading="lazy"{% endif %}>{% endfor %}
  </div>
  <div class="hero__scrim" aria-hidden="true"></div>
  <h1 class="visually-hidden">{{ profile.role | escape }} {{ profile.name | escape }} · 직접 구현하며 만듭니다.</h1>
</section>

<section id="who" aria-labelledby="who-h">
  <div class="inner">
    <div class="about-layout">
      <div class="sec-head reveal"><h2 class="eyebrow sec-label" id="who-h">01 / 소개</h2></div>
      <div class="about-copy">
        {% set lead = profile.headline | replace("C++ 개발자", "프로그래머") %}
        <p class="bio intro-headline reveal">{% if "프로그래머입니다." in lead %}{{ lead | replace("프로그래머입니다.", "") }}프로그래머 <strong class="intro-name">{{ profile.name }}</strong>입니다.{% else %}{{ lead }}{% endif %}</p>
        <p class="bio reveal">{{ profile.introduction | escape }}</p>
        <p class="bio reveal">더 자세한 프로젝트와 개발 기록은 <a href="{{ profile.github }}">GitHub</a>와 <a href="{{ profile.blog }}">노션 기술 블로그</a>에서 확인하실 수 있습니다.</p>
      </div>
      <figure class="profile-portrait reveal"><img src="{{ profile.portrait }}" alt="안지우의 프로필 사진" width="691" height="848" loading="lazy"></figure>
    </div>
  </div>
</section>

<section id="experience" aria-labelledby="experience-h">
  <div class="inner"><div class="sec-head reveal"><h2 class="eyebrow sec-label" id="experience-h">02 / 학력 · 활동 · 수상</h2></div>
    {# localActivities.json holds activities that are not in Notion, so a Notion sync does not remove them. #}
    {# Wording that differs from Notion lives in experienceCopy.json, so a Notion sync does not overwrite it. #}
    <div class="exp-groups">
      {% for group in [{ label: "학력", items: profile.education }, { label: "활동", items: profile.activities | concat(localActivities) }] %}
      <div class="exp-group reveal"><h3 class="experience-label">{{ group.label }}</h3>
        <ul class="exp-list">{% for item in group.items %}{% set parts = (experienceCopy.details[item.title] or item.details) | experienceDetails(item.period) %}
          <li class="exp-item">
            <p class="exp-period">{{ item.period | shortPeriod }}{% if parts.duration %} · {{ parts.duration }}{% endif %}</p>
            <div class="exp-body">
              <h4 class="exp-title">{% if item.logo %}<img class="exp-logo" src="{{ item.logo }}" alt="" width="28" height="28" loading="lazy">{% endif %}{{ item.title }}</h4>
              <p class="exp-desc">{{ item.description }}</p>
              {% if parts.scores.length or parts.stats.length or parts.notes.length %}<p class="exp-meta">{% if parts.scores.length %}<span>{% for score in parts.scores %}{{ score.label }} <b>{{ score.value }}</b> {{ score.suffix }}{% if not loop.last %} | {% endif %}{% endfor %}</span>{% endif %}{% for stat in parts.stats %}<span>{{ stat.label }} <b>{{ stat.value }}</b>{% if stat.suffix %} {{ stat.suffix }}{% endif %}</span>{% endfor %}{% for note in parts.notes %}<span>{{ note }}</span>{% endfor %}</p>{% endif %}
            </div>
          </li>
        {% endfor %}</ul>
      </div>
      {% endfor %}
      <div class="exp-group reveal"><h3 class="experience-label">수상</h3>
        <ul class="exp-list">{% for item in profile.awards %}{% set award = (experienceCopy.awardTitles[item.title] or item.title) | awardParts %}
          <li class="exp-item exp-award">
            <p class="exp-period award-prize{% if award.tier %} award-prize--{{ award.tier }}{% endif %}">{{ award.prize }}{% if award.rank %} <small>{{ award.rank }}</small>{% endif %}</p>
            <div class="exp-body"><h4 class="exp-title">{{ award.event }}{% if item.organization %} <small>· {{ item.organization }}</small>{% endif %}{% if item.period %} <small>· {{ item.period }}</small>{% endif %}</h4></div>
          </li>
        {% endfor %}</ul>
      </div>
    </div>
  </div>
</section>

<section id="all-projects" aria-labelledby="archive-h">
  <div class="inner"><div class="sec-head reveal"><h2 class="eyebrow sec-label" id="archive-h">03 / 전체 프로젝트</h2></div>
    {% include "prototype/archive.njk" %}
  </div>
</section>

<section id="thinking" aria-labelledby="thinking-h">
  <div class="inner">
    <div class="sec-head reveal"><h2 class="eyebrow sec-label" id="thinking-h">04 / 기술 문서와 학습</h2></div>
    <div class="knowledge-links">
      {% for entry in collections.presentations %}<a class="card knowledge-card reveal" href="{{ entry.data.notionUrl }}" target="_blank" rel="noopener noreferrer"><span class="meta meta--pop">발표 자료 / {{ loop.index }}</span><h3>{{ entry.data.displayTitle or entry.data.title }}</h3><p class="desc">{{ entry.data.description }}</p><span class="go">Notion에서 자료 보기 <span class="ar" aria-hidden="true">↗</span></span></a>{% endfor %}
      <a class="card knowledge-card reveal" href="{{ profile.blog }}"><span class="meta meta--pop">직접 배우고 남긴 기록</span><h3>노션 기술 블로그</h3><p class="desc">구현하며 배운 것과 문제를 해결한 과정.<br>개발과 학습의 기록을 이어갑니다.</p><span class="go">블로그 방문하기 <span class="ar" aria-hidden="true">↗</span></span></a>
    </div>
  </div>
</section>

<section id="personal" aria-labelledby="contact-h">
  <div class="inner">
    <h2 class="eyebrow sec-label reveal" id="contact-h">05 / 연락처 · 소셜</h2>
    <p class="bio reveal contact-copy">프로젝트나 협업에 관한 이야기는 편하게 연락 주세요.</p>
    <div class="contact-groups">
      <div class="contact-group reveal" aria-labelledby="contact-direct-h">
        <h3 id="contact-direct-h">연락처</h3>
        <div class="contact-links">
          <a href="mailto:{{ profile.email }}"><span>이메일</span><strong>{{ profile.email }}</strong><span aria-hidden="true">↗</span></a>
          <a href="{{ profile.discord }}"><span>디스코드</span><strong>juggernautsensei</strong><span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="contact-group reveal" aria-labelledby="contact-social-h">
        <h3 id="contact-social-h">소셜</h3>
        <div class="contact-links">
          <a href="{{ profile.github }}"><span>깃허브</span><strong>JuggernautSensei</strong><span aria-hidden="true">↗</span></a>
          <a href="{{ profile.blog }}"><span>노션 기술 블로그</span><strong>Jiwoo’s Blog</strong><span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </div>
</section>
