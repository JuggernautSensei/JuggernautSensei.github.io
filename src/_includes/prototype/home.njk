<section class="hero" id="home" data-accent="#79d6c3">
  <div class="hero-backgrounds" data-interval="{{ hero.intervalMs }}" aria-hidden="true">
    {% for slide in hero.slides %}<img class="hero__img{% if loop.first %} is-active{% endif %}" src="{{ slide.src }}" alt="" style="object-position:{{ slide.position }}"{% if loop.first %} fetchpriority="high"{% else %} loading="lazy"{% endif %}>{% endfor %}
  </div>
  <div class="hero__scrim" aria-hidden="true"></div>
  <div class="inner hero-layout">
    <div class="hero-heading">
      <p class="eyebrow hero-role">{{ profile.role | escape }} · {{ profile.name | escape }}</p>
      <h1 aria-label="직접 구현하며, 검증하며, 디버깅하며, 소통하며 함께 만듭니다.">
        <span class="line" aria-hidden="true"><span class="word">직접</span></span>
        <span class="line" aria-hidden="true"><span class="word hero-process"><span class="roll roll--word" id="wordroll"><span class="roll__track"><span class="roll__item">구현하며</span><span class="roll__item"></span></span></span></span></span>
        <span class="line" aria-hidden="true"><span class="word hero-final">만듭니다.</span></span>
      </h1>
    </div>
    <p class="hero-sub">게임에서 엔진과 라이브러리, 개발 도구까지.<br>구현과 검증으로 이해를 넓혀 갑니다.</p>
  </div>
</section>

<section id="who" aria-labelledby="who-h" data-accent="#79d6c3">
  <div class="inner">
    <div class="about-layout">
      <div class="sec-head reveal"><div><p class="eyebrow">01 / 소개</p><h2 class="sec-title" id="who-h">게임을 좋아하다가, 만드는 쪽으로.</h2></div></div>
      <div class="about-copy">
        {% set lead = profile.headline | replace("C++ 개발자", "프로그래머") %}
        <p class="bio intro-headline reveal">{% if "프로그래머입니다." in lead %}{{ lead | replace("프로그래머입니다.", "") }}프로그래머 <strong class="intro-name">{{ profile.name }}</strong>입니다.{% else %}{{ lead }}{% endif %}</p>
        <p class="bio reveal">{{ profile.introduction | escape }}</p>
        <p class="bio reveal">더 자세한 프로젝트와 개발 기록은 <a href="{{ profile.github }}">GitHub</a>와 <a href="{{ profile.blog }}">노션 기술 블로그</a>에서 확인하실 수 있습니다.</p>
      </div>
      <figure class="profile-portrait reveal"><img src="{{ profile.portrait }}" alt="안지우의 프로필 사진" width="691" height="848" loading="lazy"></figure>
    </div>
  </div>
</section>

<section id="experience" aria-labelledby="experience-h" data-accent="#f4cd7c">
  <div class="inner"><div class="sec-head reveal"><div><p class="eyebrow">02 / 학력 · 활동 · 수상</p><h2 class="sec-title" id="experience-h">배우고, 가르치고, 함께 쌓은 경험.</h2></div></div>
    <div class="exp-rows">
      {% for group in [{ label: "학력", items: profile.education }, { label: "활동", items: profile.activities }] %}
      <div class="exp-row reveal"><h3 class="experience-label">{{ group.label }}</h3>
        <div class="exp-entries">{% for item in group.items %}{% set parts = item.details | experienceDetails(item.period) %}
          <article class="exp-entry">
            {% if item.logo %}<span class="exp-logo"><img src="{{ item.logo }}" alt="" width="64" height="64" loading="lazy"></span>{% endif %}
            <div class="exp-body">
              <div class="exp-head"><h4>{{ item.title }}</h4><p class="timeline-period">{{ item.period }}{% if parts.duration %} · {{ parts.duration }}{% endif %}</p></div>
              <p class="exp-desc">{{ item.description }}</p>
              {% if parts.stats.length %}<dl class="exp-stats">{% for stat in parts.stats %}<div><dt>{{ stat.label }}</dt><dd>{{ stat.value }}{% if stat.suffix %} <span>{{ stat.suffix }}</span>{% endif %}</dd></div>{% endfor %}</dl>{% endif %}
              {% if parts.notes.length %}<ul class="exp-notes">{% for note in parts.notes %}<li>{{ note }}</li>{% endfor %}</ul>{% endif %}
            </div>
          </article>
        {% endfor %}</div>
      </div>
      {% endfor %}
      {# Awards from the school listed under 학력 are already marked 교내 and its logo shows above, so only other organizations are named. #}
      <div class="exp-row reveal"><h3 class="experience-label">수상</h3>
        <ul class="award-list">{% for item in profile.awards %}{% set award = item.title | awardParts %}
          <li><span class="award-prize{% if award.tier %} award-prize--{{ award.tier }}{% endif %}">{{ award.prize }}{% if award.rank %} <small>{{ award.rank }}</small>{% endif %}</span><span class="award-event">{{ award.event }}{% if item.organization != profile.education[0].title %} <small>· {{ item.organization }}</small>{% endif %}</span>{% if item.period %}<span class="timeline-period">{{ item.period }}</span>{% endif %}</li>
        {% endfor %}</ul>
      </div>
    </div>
  </div>
</section>

<section id="all-projects" aria-labelledby="archive-h" data-accent="#79a7ff">
  <div class="inner"><div class="sec-head reveal"><div><p class="eyebrow">03 / 전체 프로젝트</p><h2 class="sec-title" id="archive-h">만들고 탐구한 프로젝트들.</h2></div></div>
    {% include "prototype/archive.njk" %}
  </div>
</section>

<section id="thinking" aria-labelledby="thinking-h" data-accent="#79d6c3">
  <div class="inner">
    <div class="sec-head reveal"><div><p class="eyebrow">04 / 기술 문서와 학습</p><h2 class="sec-title" id="thinking-h">구현한 내용을 기록하고 나눕니다.</h2></div></div>
    <div class="knowledge-links">
      {% for entry in collections.presentations %}<a class="card knowledge-card reveal" href="{{ entry.url }}"><span class="meta meta--pop">발표 자료 / {{ loop.index }}</span><h3>{{ entry.data.displayTitle or entry.data.title }}</h3><p class="desc">{{ entry.data.description }}</p><span class="go">자료 살펴보기 <span class="ar" aria-hidden="true">↗</span></span></a>{% endfor %}
      <a class="card knowledge-card reveal" href="{{ profile.blog }}"><span class="meta meta--pop">직접 배우고 남긴 기록</span><h3>노션 기술 블로그</h3><p class="desc">구현하며 배운 것과 문제를 해결한 과정.<br>개발과 학습의 기록을 이어갑니다.</p><span class="go">블로그 방문하기 <span class="ar" aria-hidden="true">↗</span></span></a>
    </div>
  </div>
</section>

<section id="personal" aria-labelledby="contact-h" data-accent="#79d6c3">
  <div class="inner">
    <p class="eyebrow reveal">05 / 연락처 · 소셜</p>
    <h2 class="sec-title reveal" id="contact-h">다음 이야기는, 함께.</h2>
    <p class="bio reveal contact-copy">프로젝트나 협업에 관한 이야기는 편하게 연락 주세요.</p>
    <div class="contact-groups">
      <div class="contact-group reveal" aria-labelledby="contact-direct-h">
        <h3 id="contact-direct-h">연락처</h3>
        <div class="contact-links">
          <a href="mailto:{{ profile.email }}"><span>이메일</span><strong>{{ profile.email }}</strong><span aria-hidden="true">↗</span></a>
          <a href="{{ profile.discord }}"><span>디스코드</span><strong>juggernautsensei</strong><span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="contact-group reveal" aria-labelledby="contact-social-h">
        <h3 id="contact-social-h">소셜</h3>
        <div class="contact-links">
          <a href="{{ profile.github }}"><span>깃허브</span><strong>JuggernautSensei</strong><span aria-hidden="true">↗</span></a>
          <a href="{{ profile.blog }}"><span>노션 기술 블로그</span><strong>Jiwoo’s Blog</strong><span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </div>
</section>
