---
title: 안지우 소셜 링크
visibility: public
publish: true
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>안지우 소셜 링크</title>
  <style>
    * { box-sizing: border-box; }
    html { color-scheme: dark; }
    body { margin: 0; background: #191919; color: #f0f0ed; font-family: Arial, "Malgun Gothic", sans-serif; }
    main { display: grid; gap: 12px; padding: 2px; }
    a { display: flex; height: 108px; overflow: hidden; border: 1px solid #373737; border-radius: 12px; color: inherit; text-decoration: none; transition: border-color .15s; }
    a:hover, a:focus-visible { border-color: #79d6c3; outline: 2px solid #79d6c3; outline-offset: -2px; }
    img { flex: 0 0 30%; width: 30%; max-width: 132px; min-width: 76px; height: 100%; object-fit: cover; background: #202625; }
    .text { display: flex; flex-direction: column; justify-content: center; gap: 5px; min-width: 0; padding: 9px 15px; }
    .label { color: #79d6c3; font-size: 9px; font-weight: 700; letter-spacing: 1.2px; }
    h2 { margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 16px; line-height: 1.2; }
    p { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; margin: 0; font-size: 12px; line-height: 1.4; word-break: keep-all; overflow-wrap: anywhere; }
    .domain { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #ababab; font-size: 10px; }
    @media (max-width: 320px) { .text { padding: 8px 10px; gap: 5px; } h2 { font-size: 14px; } p { font-size: 11px; } }
    @media (prefers-reduced-motion: reduce) { a { transition: none; } }
  </style>
</head>
<body>
  <main aria-label="소셜 링크">
    {% for card in socialCards %}
    <a href="{{ card.url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ card.title }} 새 탭에서 열기">
      <img src="{{ card.image }}" alt="{{ card.alt }}" style="object-position: {{ card.position }}">
      <div class="text">
        <span class="label">{{ card.label }}</span>
        <h2>{{ card.title }}</h2>
        <p>{{ card.description }}</p>
        <span class="domain">{{ card.domain }}</span>
      </div>
    </a>
    {% endfor %}
  </main>
</body>
</html>
